# Copie para .env.local e preencha. Validado por env.ts (T3 Env): o build falha se faltar algo obrigatório.

# --- Banco ---------------------------------------------------------------
# Produção/preview: injetada pela integração Neon da Vercel (use a URL "pooled").
# Desenvolvimento local sem Postgres: PGlite embutido, persistido na pasta indicada.
DATABASE_URL=pglite://./.data/dev

# --- Better Auth ---------------------------------------------------------
# Segredo com 32+ caracteres: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# URL pública do app (sem barra final). Em produção, a URL definitiva do projeto.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Login com Google (opcional em dev) ----------------------------------
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail ----------------------------------------------------------------
# gmail   = envia via Gmail SMTP (produção)
# console = imprime o e-mail no terminal (desenvolvimento)
# outbox  = grava em .data/outbox (testes automatizados)
EMAIL_TRANSPORT=console
# Conta Gmail com verificação em duas etapas + senha de app (myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=

# --- Cron -------------------------------------------------------------------
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" nas execuções agendadas.
CRON_SECRET=
